DATABASE_URL="postgresql://user:pass@localhost:5432/eventcast?schema=public"

# 固定的對外網址，Magic Link 一律用這個組出，不信任 request 的 Host header
APP_BASE_URL="http://localhost:3000"

# API Token hash 用的 pepper；Session cookie（jose）簽章用的密鑰
# 本機開發可用 `openssl rand -hex 32` 各自產生一組
TOKEN_HASH_SECRET=""
SESSION_SECRET=""

# 寄送 Magic Link Email 用；NODE_ENV=development 時會改印在 console，不需要真的填
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
